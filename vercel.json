{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "angular"
    },
    "scraper": {
      "root": "scraper",
      "runtime": "node",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "scraper" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
